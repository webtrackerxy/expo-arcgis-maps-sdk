{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "declaration": true,
    "outDir": "build",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["build", "src/**/__tests__/**"]
}
